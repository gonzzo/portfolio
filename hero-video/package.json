{
  "name": "hero-video",
  "version": "1.0.0",
  "description": "Seamless embedded systems background for Gonzalo Combarros' portfolio",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^18.18.0 || ^20.9.0 || >=21.1.0"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.540",
    "@types/react": "19.3.0",
    "@types/web": "0.0.166",
    "eslint": "9.39.5",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "render": "remotion render src/index.ts EmbeddedSystems ../assets/video/embedded-systems.mp4 --codec=h264 --crf=25 --pixel-format=yuv420p --muted --concurrency=2",
    "poster": "remotion still src/index.ts EmbeddedSystems ../assets/video/embedded-systems-poster.jpg --frame=80 --image-format=jpeg",
    "typecheck": "tsc --noEmit",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc"
  },
  "allowScripts": {
    "esbuild": false
  }
}
